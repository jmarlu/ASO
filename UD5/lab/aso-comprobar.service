[Unit]
Description=Comprobacion de nginx ASO

[Service]
Type=oneshot
User=asoauto
Group=asoauto
UMask=0077
ExecStart=/usr/local/lib/aso-ud5/comprobar-servicio.sh nginx.service /var/lib/aso-ud5/estado
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aso-ud5
